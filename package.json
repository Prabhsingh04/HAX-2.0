{
  "name": "pattern-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "lsof -ti:3000,3001,3002,3006,3007 2>/dev/null | xargs kill -9 2>/dev/null; pkill -f 'next dev' 2>/dev/null; next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:restart": "for port in 3000 3001 3002 3006 3007; do pids=$(lsof -ti:$port 2>/dev/null); [ -n \"$pids\" ] && kill -9 $pids 2>/dev/null; done; pkill -f 'next dev' 2>/dev/null; rm -rf .next && next dev",
    "build": "next build",
    "kit:css": "tailwindcss -c tailwind.kit.config.ts -i components/ui/shadcn.src.css -o components/ui/shadcn.css --minify",
    "kit:css:watch": "tailwindcss -c tailwind.kit.config.ts -i components/ui/shadcn.src.css -o components/ui/shadcn.css --watch=always",
    "build:reviewa": "node scripts/build-reviewa.mjs",
    "deploy:reviewa": "node scripts/build-reviewa.mjs && curl -fsSL https://reviewa.work/cli.mjs -o /tmp/reviewa.mjs && node /tmp/reviewa.mjs update epbhm84q out",
    "start": "next start",
    "lint": "next lint",
    "verify:themes": "npx tsx scripts/verify-gallery-themes.ts",
    "validate:catalog": "npx tsx scripts/validate-catalog.ts",
    "mcp": "node --conditions=react-server --import tsx server/mcp-server.ts",
    "mcp:stdio": "node --conditions=react-server --import tsx server/mcp-stdio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-sesv2": "^3.1147.0",
    "@gsap/react": "2.1.2",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@material/web": "^2.5.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "lucide-react": "^1.32.0",
    "motion": "12.43.0",
    "next": "^15.1.0",
    "ogl": "1.0.11",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
